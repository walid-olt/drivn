# Drivn environment template (root / API)
# Copy this file to the appropriate environment file depending on what you're doing:
#   - `.env.development` -> local dev (`pnpm dev`)
#   - `.env.test`        -> tests (`pnpm test`, DB is provided by mongodb-memory-server)
#   - `.env.production`  -> production (usually injected by the platform instead)

MONGODB_URI=
MONGODB_DBNAME=drivn-dev
PORT=3000
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
BETTER_AUTH_SECRET=
NODE_ENV=development

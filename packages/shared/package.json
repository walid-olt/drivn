{
  "name": "@drivn/shared",
  "version": "0.0.2",
  "private": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsdown src/index.ts --format cjs,esm --dts --no-clean",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "tsdown": "^0.22.4",
    "typescript": "^5.7.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.8"
  }
}
